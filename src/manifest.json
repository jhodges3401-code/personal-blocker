{
  "manifest_version": 3,
  "name": "Personal Blocker",
  "version": "0.2.3",
  "description": "Personal clean-room ad and tracker blocker (EasyList + EasyPrivacy compiled to declarativeNetRequest).",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.twitch.tv/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Blocker"
  },
  "options_page": "options.html",
  "web_accessible_resources": [],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lists_1",
        "enabled": true,
        "path": "rules/lists_1.json"
      },
      {
        "id": "lists_2",
        "enabled": true,
        "path": "rules/lists_2.json"
      },
      {
        "id": "lists_3",
        "enabled": true,
        "path": "rules/lists_3.json"
      },
      {
        "id": "lists_4",
        "enabled": true,
        "path": "rules/lists_4.json"
      }
    ]
  },
  "key": ""
}